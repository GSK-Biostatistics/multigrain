    {
      "id": "t--evaluate",
      "type": "text",
      "x": 893,
      "y": 1259,
      "width": 234,
      "height": 247.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
